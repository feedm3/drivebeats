{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "drivebeats": {
      "type": "streamable-http",
      "url": "https://www.drivebeats.app/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "drivebeats-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "profile:read",
              "library:read",
              "library:write",
              "media:read"
            ],
            "resource": "https://www.drivebeats.app/mcp"
          }
        }
      }
    }
  }
}
